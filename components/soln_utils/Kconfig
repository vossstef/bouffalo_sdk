    int "MJPEG decoder log level"
    range 0 5
    default 3
    depends on SOLN_VID_JPEG_DEC_EN
    help
      Log level for the MJPEG decoder adapter.

config SOLN_AUD_UAC_LOG_LEVEL
    int "UAC log level"
    range 0 5
    default 3
    depends on SOLN_AUD_UAC_IN_EN || SOLN_AUD_UAC_OUT_EN
    help
      Log level for the USB Audio Class adapter.

config SOLN_VID_UVC_LOG_LEVEL
    int "UVC log level"
    range 0 5
    default 3
    depends on SOLN_VID_UVC_YUYV_EN || SOLN_VID_UVC_JPEG_EN
    help
      Log level for the USB Video Class adapter.

config SOLN_SD_AVI_LOG_LEVEL
    int "SD AVI log level"
    range 0 5
    default 3
    depends on SOLN_SD_AVI_VIDEO_EN || SOLN_SD_AVI_AUDIO_EN
    help
      Log level for the SD card AVI adapter.

config SOLN_SD_JPEG_LOG_LEVEL
    int "SD JPEG log level"
    range 0 5
    default 3
    depends on SOLN_SD_AVI_VIDEO_EN || SOLN_SD_AVI_AUDIO_EN
    help
      Log level for the SD card JPEG adapter.

config SOLN_RTSP_LOG_LEVEL
    int "RTSP log level"
    range 0 5
    default 3
    depends on SOLN_RTSP_EN
    help
      Log level for the RTSP adapter.

config SOLN_HB_TX_LOG_LEVEL
    int "HiBooster sender log level"
    range 0 5
    default 3
    depends on SOLN_HB_TX_EN
    help
      Log level for the HiBooster sender adapter.

config SOLN_HB_RX_LOG_LEVEL
    int "HiBooster receiver log level"
    range 0 5
    default 3
    depends on SOLN_HB_RX_EN
    help
      Log level for the HiBooster receiver adapter.

config SOLN_FPS_PRINT_EN
    bool "Print FPS statistics"
    default y
    depends on SOLN_UTILS
    help
      Print periodic FPS statistics from the Soln solution task.

config SOLN_FPS_STAT_INTERVAL_MS
    int "FPS statistics interval in milliseconds"
    range 1 60000
    default 1000
    depends on SOLN_UTILS
    help
      Sampling interval used by the FPS statistics task.

config SOLN_FPS_PRINT_INTERVAL_MULTIPLIER
    int "FPS print interval multiplier"
    range 1 60
    default 3
    depends on SOLN_FPS_PRINT_EN
    help
      Number of samples between periodic FPS log messages.

endmenu

menu "Soln display timing"

config SOLN_DISP_TX_TIME_US
    int "Display transfer time in microseconds"
    range 1 1000000
    default 17000
    depends on SOLN_DISP_DBI_EN
    help
      Estimated display transfer time used by the TE timing logic.

config SOLN_DISP_TE_BOUNDARY_US
    int "Display TE boundary in microseconds"
    range 0 1000000
    default 0
    depends on SOLN_DISP_DBI_EN
    help
      Optional TE timing boundary used by the display flush adapter.

endmenu

menu "Soln diagnostics"

config SOLN_HB_TX_TEST_EN
    bool "HiBooster sender test"
    default n
    depends on SOLN_UTILS
    depends on LWIP
    help
      Build the HiBooster sender test application code.

config SOLN_HB_RX_TEST_EN
    bool "HiBooster receiver test"
    default n
    depends on SOLN_UTILS
    depends on LWIP
    help
      Build the HiBooster receiver test application code.

config SOLN_HB_TX_TEST_LOG_LEVEL
    int "HiBooster sender test log level"
    range 0 5
    default 3
    depends on SOLN_HB_TX_TEST_EN
    help
      Log level for the HiBooster sender test code.

config SOLN_HB_RX_TEST_LOG_LEVEL
    int "HiBooster receiver test log level"
    range 0 5
    default 3
    depends on SOLN_HB_RX_TEST_EN
    help
      Log level for the HiBooster receiver test code.

endmenu