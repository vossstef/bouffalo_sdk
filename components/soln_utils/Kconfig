#
# Soln solution utility component
#

menuconfig SOLN_UTILS
    bool "Enable Soln solution utility component"
    default n
    depends on FREERTOS
    help
      Build the shared Soln frame queue and configurable audio, video,
      storage, USB, network and display utility modules.

rsource "Kconfig.soln_frq"

menu "Soln audio functions"

config SOLN_AUD_AUADC_EN
    bool "Internal audio ADC"
    default n
    depends on SOLN_FBQ_AUD_PCM_LOCAL_EN
    help
      Enable audio capture through the internal audio ADC.

config SOLN_AUD_AUDAC_EN
    bool "Internal audio DAC"
    default n
    depends on SOLN_FBQ_AUD_PCM_REMOTE_EN
    help
      Enable audio playback through the internal audio DAC.

config SOLN_AUD_I2S_IN_EN
    bool "External codec I2S input"
    default n
    depends on SOLN_FBQ_AUD_PCM_LOCAL_EN
    help
      Enable audio capture through an external codec connected by I2S.

config SOLN_AUD_I2S_OUT_EN
    bool "External codec I2S output"
    default n
    depends on SOLN_FBQ_AUD_PCM_REMOTE_EN
    help
      Enable audio playback through an external codec connected by I2S.

config SOLN_AUD_UAC_IN_EN
    bool "USB audio input"
    default n
    depends on SOLN_FBQ_AUD_PCM_LOCAL_EN
    depends on CHERRYUSB_HOST_AUDIO
    depends on !SOLN_AUD_AUADC_EN
    help
      Enable USB Audio Class host capture.

config SOLN_AUD_UAC_OUT_EN
    bool "USB audio output"
    default n
    depends on SOLN_FBQ_AUD_PCM_REMOTE_EN
    depends on CHERRYUSB_HOST_AUDIO
    help
      Enable USB Audio Class host playback.

config SOLN_AUD_LOOPBACK_EN
    bool "Audio loopback"
    default n
    depends on SOLN_FBQ_AUD_PCM_LOCAL_EN && SOLN_FBQ_AUD_PCM_REMOTE_EN
    help
      Enable the PCM audio loopback task.

config SOLN_AUD_ES8388_EN
    bool "ES8388 codec configuration"
    default n
    depends on SOLN_AUD_I2S_IN_EN || SOLN_AUD_I2S_OUT_EN
    help
      Enable ES8388 external codec initialization and control helpers.

endmenu

menu "Soln video functions"

config SOLN_VID_DEFAULT_WIDTH
    int "Default video width"
    range 1 4096
    default 640
    depends on SOLN_UTILS
    help
      Default width used by the solution video pipeline.

config SOLN_VID_DEFAULT_HEIGHT
    int "Default video height"
    range 1 4096
    default 480
    depends on SOLN_UTILS
    help
      Default height used by the solution video pipeline.

config SOLN_DISP_DBI_EN
    bool "DBI display"
    default n
    depends on SOLN_FBQ_VID_RAW_LOCAL_EN || SOLN_FBQ_VID_RAW_REMOTE_EN
    depends on BSP_LCD
    help
      Enable the MCU DBI display consumer.

config SOLN_DISP_RGB_EN
    bool "RGB display"
    default n
    depends on SOLN_FBQ_VID_RAW_LOCAL_EN || SOLN_FBQ_VID_RAW_REMOTE_EN
    depends on BSP_LCD
    depends on !SOLN_DISP_DBI_EN
    help
      Enable the RGB display consumer.

config SOLN_VID_JPEG_ENC_EN
    bool "MJPEG encoder"
    default n
    depends on SOLN_FBQ_VID_JPEG_LOCAL_EN && SOLN_FBQ_VID_RAW_LOCAL_EN
    help
      Enable hardware MJPEG encoding.

config SOLN_VID_JPEG_DEC_EN
    bool "MJPEG decoder"
    default n
    depends on SOLN_FBQ_VID_JPEG_REMOTE_EN && SOLN_FBQ_VID_RAW_REMOTE_EN
    help
      Enable hardware MJPEG decoding.

config SOLN_VID_JPEG_DEC_OUTPUT_FORMAT
    int "MJPEG decoder output format"
    range 1 4
    default 1
    depends on SOLN_VID_JPEG_DEC_EN
    help
      Decoder output format: 1 RGB565, 2 RGB888, 3 NRGB8888, 4 YUYV.

config SOLN_VID_DVP_EN
    bool "DVP image sensor"
    default n
    depends on SOLN_FBQ_VID_RAW_LOCAL_EN
    depends on BSP_IMAGE_SENSOR
    help
      Enable DVP camera sensor capture.

config SOLN_VID_DVP_JPEG_ENC_EN
    bool "DVP JPEG encoder"
    default n
    depends on SOLN_FBQ_VID_JPEG_LOCAL_EN
    depends on BSP_IMAGE_SENSOR
    depends on !SOLN_VID_JPEG_ENC_EN
    help
      Enable the DVP line-buffer JPEG encoder pipeline.

config SOLN_VID_UVC_YUYV_EN
    bool "USB UVC YUYV input"
    default n
    depends on SOLN_FBQ_VID_RAW_LOCAL_EN
    depends on CHERRYUSB_HOST_VIDEO
    depends on !SOLN_VID_DVP_EN
    help
      Enable USB Video Class capture in YUYV format.

config SOLN_VID_UVC_JPEG_EN
    bool "USB UVC JPEG input"
    default n
    depends on SOLN_FBQ_VID_JPEG_LOCAL_EN
    depends on CHERRYUSB_HOST_VIDEO
    depends on !SOLN_VID_JPEG_ENC_EN && !SOLN_VID_DVP_JPEG_ENC_EN
    help
      Enable USB Video Class capture in JPEG format.

endmenu

menu "Solution storage and network functions"

config SOLN_SD_AVI_VIDEO_EN
    bool "Save video AVI to SD card"
    default n
    depends on FATFS && (SOLN_FBQ_VID_JPEG_LOCAL_EN || SOLN_FBQ_VID_JPEG_REMOTE_EN)
    depends on FATFS_SDH_SDCARD && BSP_SDH_SD
    help
      Save JPEG video frames to an AVI file on an SD card.

config SOLN_SD_AVI_AUDIO_EN
    bool "Save audio AVI to SD card"
    default n
    depends on FATFS && SOLN_FBQ_AUD_PCM_REMOTE_EN
    depends on FATFS_SDH_SDCARD && BSP_SDH_SD
    help
      Save PCM audio frames to an AVI file on an SD card.

config SOLN_HB_TX_EN
    bool "HiBooster sender"
    default n
    depends on LWIP && SOLN_FBQ_VID_JPEG_LOCAL_EN
    help
      Enable the Soln HiBooster JPEG sender adapter.

config SOLN_HB_RX_EN
    bool "HiBooster receiver"
    default n
    depends on LWIP && SOLN_FBQ_VID_JPEG_REMOTE_EN
    help
      Enable the Soln HiBooster JPEG receiver adapter.

config SOLN_RTSP_EN
    bool "RTSP video server"
    default n
    depends on RTSP && LWIP && SOLN_FBQ_VID_JPEG_LOCAL_EN
    help
      Enable the Soln RTSP video adapter.

endmenu

menu "Soln logging"

config SOLN_LOG_LEVEL
    int "Solution log level"
    range 0 5
    default 3
    depends on SOLN_UTILS
    help
      Log level: 0=fatal, 1=error, 2=warning, 3=info, 4=debug, 5=trace.

config SOLN_FBQ_LOG_LEVEL
    int "Frame queue log level"
    range 0 5
    default 3
    depends on SOLN_UTILS
    help
      Log level for the Soln frame queue implementation.

config SOLN_AUD_AUADC_LOG_LEVEL
    int "Audio ADC log level"
    range 0 5
    default 3
    depends on SOLN_AUD_AUADC_EN
    help
      Log level for the internal audio ADC adapter.

config SOLN_AUD_AUDAC_LOG_LEVEL
    int "Audio DAC log level"
    range 0 5
    default 3
    depends on SOLN_AUD_AUDAC_EN
    help
      Log level for the internal audio DAC adapter.

